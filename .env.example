# --- Roboflow Hosted Inference API -------------------------------------------
# Get a key from https://app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=
MODEL_ID=road-damage-medium-9semt/1

# --- Detection / pipeline tuning ---------------------------------------------
# Minimum confidence kept from the API response (0.0 - 1.0)
CONF_THRESHOLD=0.35
# Only every Nth frame is sent to Roboflow. Higher = fewer API calls = faster.
FRAME_STRIDE=5
# Upload size cap in megabytes
MAX_UPLOAD_MB=200
# 1 = deterministic fake detections, no network / no API key needed
MOCK_DETECTOR=0

# --- Frontend build-time config ----------------------------------------------
VITE_API_URL=http://localhost:8007
VITE_MEDIA_URL=http://localhost:3006
